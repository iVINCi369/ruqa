{
  "appId": "com.ruqa.desktop",
  "electronVersion": "40.10.0",
  "electronDownload": {
    "cache": ".electron-dist"
  },
  "icon": "build/icon.png",
  "asar": false,
  "directories": {
    "output": "out"
  },
  "files": [
    "dist/**/*",
    "package.json",
    "!dist/**/*.map",
    "!**/node_modules/react-native/**",
    "!**/node_modules/react-native-*/**",
    "!**/node_modules/@react-native/**",
    "!**/node_modules/@expo/**",
    "!**/node_modules/expo-*/**"
  ],
  "linux": {
    "executableName": "ruqa",
    "icon": "build/icon.png",
    "target": ["AppImage"],
    "artifactName": "${productName}-${arch}.${ext}",
    "category": "Network;FileTransfer",
    "mimeTypes": ["application/octet-stream", "inode/directory", "x-scheme-handler/ruqa"]
  },
  "toolsets": {
    "appimage": "1.0.2"
  },
  "afterPack": "scripts/afterPack.cjs",
  "extraResources": [
    {
      "from": "build/tray",
      "to": "tray",
      "filter": ["**/*"]
    },
    {
      "from": "../../native/iroh-bridge/target/release/iroh-bridge",
      "to": "iroh-bridge"
    }
  ]
}
