# Maintainer: Reazndev <ruby.florian@proton.me>

pkgname=ruqa-bin
pkgver=1.7.0
pkgrel=1
pkgdesc='Private peer-to-peer file transfer application (prebuilt binary)'
arch=('x86_64' 'aarch64')
url='https://ruqa.app/'
license=('Apache-2.0')
depends=('gtk3' 'libnotify' 'libsecret' 'libxss' 'nss')
provides=('ruqa')
conflicts=('ruqa' 'ruqa-git')
options=('!strip')
source_x86_64=("Ruqa-x86_64.AppImage::https://github.com/iVINCi369/ruqa/releases/download/v${pkgver}/Ruqa-x86_64.AppImage")
sha256sums_x86_64=('52d7245103f8a8f2e05ed6b62a39d19303c68bf45d6aadb07bc7abb2b77c23e4')
source_aarch64=("Ruqa-arm64.AppImage::https://github.com/iVINCi369/ruqa/releases/download/v${pkgver}/Ruqa-arm64.AppImage")
sha256sums_aarch64=('526d17c8fd58fac6dbb7da12524ca544aba5419ec1b3b5f73fcc0b2342c0aa26')

prepare() {
  cd "$srcdir"

  local appimage
  case "$CARCH" in
    x86_64) appimage=Ruqa-x86_64.AppImage ;;
    aarch64) appimage=Ruqa-arm64.AppImage ;;
  esac

  chmod +x "$appimage"
  "./$appimage" --appimage-extract
}

package() {
  cd "$srcdir"

  install -d "$pkgdir/opt/ruqa"
  cp -a --no-preserve=ownership squashfs-root/. "$pkgdir/opt/ruqa/"

  install -Dm755 /dev/stdin "$pkgdir/usr/bin/ruqa" <<'EOF'
#!/bin/sh
exec /opt/ruqa/AppRun "$@"
EOF

  install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/ruqa.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=Ruqa
Comment=Private peer-to-peer file transfer
Exec=ruqa %U
Icon=ruqa
Categories=Network;FileTransfer;
MimeType=application/octet-stream;inode/directory;x-scheme-handler/ruqa;
StartupNotify=true
Terminal=false
StartupWMClass=ruqa
EOF

  install -Dm644 squashfs-root/ruqa.png \
    "$pkgdir/usr/share/icons/hicolor/512x512/apps/ruqa.png"
}
